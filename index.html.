<!DOCTYPE html>
<html lang="en">
<head>
<link rel="icon" type="image/png" href="favicon.png">
  <meta charset="UTF-8">
  <title>Weather Dashboard</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- Search Section -->
  <div class="search-container">
    <input type="text" id="city-input" placeholder="Enter city name">
    <button id="search-btn">Search</button>
  </div>

  <!-- Current Weather -->
  <div id="current-weather"></div>

  <!-- Forecast Section -->
  <h2>5-Day Forecast</h2>
  <div id="forecast" class="forecast-cards"></div>

  <!-- Search History -->
  <h2>Search History</h2>
  <ul id="search-history"></ul>

<h2>Search History</h2>
<ul id="search-history"></ul>
<button id="clear-history">Clear History</button>

  <script src="script.js"></script>
</body>
</html>

<body>
  <!-- Search Form -->
  <form id="search-form">
    <input type="text" id="search-input" placeholder="Enter city name">
    <button type="submit">Search</button>
  </form>

  <!-- Weather Display -->
  <div id="current-weather"></div>
  <div id="forecast"></div>

  <!-- Alerts Section -->
  <div id="alerts"></div>
  <button id="reset-alerts">🔄 Show All Alerts</button>
  <p id="countdown"></p>

  <script src="script.js"></script>
</body>

<audio id="refresh-sound" src="chime.mp3" preload="auto"></audio>

<!-- Settings Button -->
<button id="open-settings">⚙️ Settings</button>

<!-- Sidebar Settings Panel -->
<div id="settings-sidebar" class="sidebar">
  <div class="sidebar-content">
    <span id="close-settings" class="close">&times;</span>
    <h2>Empire Hustle Settings</h2>

    <!-- Tab Navigation -->
    <div class="tabs">
      <button class="tab-btn active" data-tab="general">General</button>
      <button class="tab-btn" data-tab="alerts">Alerts</button>
      <button class="tab-btn" data-tab="theme">Theme</button>
    </div>

    <!-- Tab Content -->
    <div id="general" class="tab-content active">
      <label>
        Refresh interval (minutes):
        <input type="number" id="refresh-interval" value="60" min="5" step="5">
      </label>
    </div>

    <div id="alerts" class="tab-content">
      <label>
        <input type="checkbox" id="enable-feedback" checked>
        🔔 Enable sound & vibration
      </label>
    </div>

    <div id="theme" class="tab-content">
      <label>
        Theme:
        <select id="theme-select">
          <option value="dark">🌑 Dark</option>
          <option value="light">☀️ Light</option>
        </select>
      </label>
    </div>
  </div>
</div>

<div class="tabs">
  <button class="tab-btn active" data-tab="general">⚙️ General</button>
  <button class="tab-btn" data-tab="alerts">🔔 Alerts</button>
  <button class="tab-btn" data-tab="theme">🌑☀️ Theme</button>
</div>
